rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para el proyecto planmute (dejota2021 MUTE)
    // Permite lectura y escritura inmediata desde cualquier dispositivo sin necesidad de login previo
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
